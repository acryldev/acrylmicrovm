# ============================================================================
# ACRYL microVMs REST Reference Server
# ============================================================================
# Development defaults only. Do not use these credentials or secrets in production.

ACRYLMICROVM_SERVER_HOST=0.0.0.0
ACRYLMICROVM_SERVER_PORT=8080
ACRYLMICROVM_SERVER_LOG_LEVEL=info
ACRYLMICROVM_SERVER_JWT_SECRET=acrylmicrovm-reference-server-secret
ACRYLMICROVM_SERVER_JWT_EXPIRY_SECONDS=3600

# ============================================================================
# ACRYL microVMs Runtime Options (consumed by openapi/reference-server/server.py)
# ============================================================================
# Use an absolute path.
ACRYLMICROVM_RUNTIME_HOME_DIR=/tmp/acrylmicrovm-reference-server
# Comma-separated list, first successful pull wins.
ACRYLMICROVM_RUNTIME_IMAGE_REGISTRIES=mirror.gcr.io,docker.io

# ============================================================================
# Optional debugging
# ============================================================================
# RUST_LOG=debug
