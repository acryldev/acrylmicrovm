{
  "name": "acrylmicrovm",
  "version": "0.13.2",
  "description": "ACRYL microVMs: run untrusted code in micro-VMs with their own kernel. Node SDK and the acrylmicrovm command.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "acrylmicrovm": "bin/acrylmicrovm.js"
  },
  "files": [
    "dist",
    "bin",
    "native/acrylmicrovm.js"
  ],
  "workspaces": [
    "npm/*"
  ],
  "napi": {
    "binaryName": "acrylmicrovm",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ],
    "package": {
      "name": "acrylmicrovm"
    }
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"lib/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"vitest.config.ts\" \"package.json\" \"tsconfig.json\"",
    "format:check": "prettier --check \"lib/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"vitest.config.ts\" \"package.json\" \"tsconfig.json\"",
    "build:native": "mkdir -p native && napi build --platform --js acrylmicrovm.js --esm --output-dir native",
    "artifacts": "napi create-npm-dirs --npm-dir npm && napi artifacts --output-dir native --npm-dir npm && node -e \"const{readdirSync,rmSync}=require('fs');readdirSync('npm').forEach(p=>{if(!readdirSync('npm/'+p).some(f=>f.endsWith('.node')))rmSync('npm/'+p,{recursive:true})})\"",
    "prepack": "napi prepublish -p npm --skip-optional-publish --tag-style npm",
    "pack:all": "mkdir -p packages && npm pack --pack-destination packages && npm pack --workspaces --pack-destination packages",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "playwright-core": "1.58.0",
    "prettier": "^3.6.2",
    "typescript": "^5.2.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "playwright-core": ">=1.58.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "keywords": [
    "acrylmicrovm",
    "sandbox",
    "container",
    "virtualization",
    "vm",
    "kvm",
    "hypervisor",
    "isolation",
    "security",
    "code-execution"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/acryldev/acrylmicrovm.git",
    "directory": "sdks/node"
  },
  "bugs": {
    "url": "https://github.com/acryldev/acrylmicrovm/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "WebBoxes s.r.o.",
  "homepage": "https://acryl.dev/acrylmicrovm"
}
